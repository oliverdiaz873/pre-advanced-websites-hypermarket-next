# Next.js storefront — Hipermercado Superior
#
# Copia este archivo a `.env.local` para desarrollo local. Los valores por
# defecto apuntan al backend local (Express + MongoDB en http://localhost:3000).
# En producción, sustituirlos por la URL real del backend desplegado.

# Base del backend para llamadas desde el CLIENTE (catálogo público).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Base del backend para llamadas SERVER-side (RSC / Server Actions / Route
# Handlers): reenvío de la cookie hypermarket_auth y flujos de auth. No debe
# empezar por NEXT_PUBLIC_ (no se expone al cliente).
API_URL=http://localhost:3000/api

# Base pública para resolver claves de imagen (uploads / storage).
NEXT_PUBLIC_STORAGE_PUBLIC_URL=http://localhost:3000